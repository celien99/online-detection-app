            "color_branch": {
              "enabled": false,
              "threshold_quantile": 0.99,
              "min_valid_pixel_ratio": 0.4
            },
            "filter_classifier": {
              "enabled": true,
              "model_path": "backend/deployed_models/line_a/filter_classifier/model.pt",
              "device": "cpu",
              "input_size": 224,
              "confidence_threshold": 0.5
            },
            "rule_engine": {
              "enabled": true,
              "deployed_rules_path": "backend/deployed_models/line_a/rules/rules.json",
              "rules": []
