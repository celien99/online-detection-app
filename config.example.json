{
  "app": {
    "line_id": "A-03",
    "station_id": "seat_inspection",
    "language": "zh-CN",
    "fullscreen": true,
    "grid_layout": "2x2",
    "inspection_mode": "continuous",
    "trigger_poll_interval_s": 0.05,
    "capture_timeout_s": 2.0
  },
  "cameras": [
    {
      "camera_id": "CAM_FRONT",
      "source": "mvs://0?exposure_time=6000&gain=8&pixel_format=bgr8",
      "type": "mvs",
      "enabled": true,
      "patchcore_model_path": "./models/cam_front_patchcore.npz",
      "color_insensitive_mode": true,
      "detection": {
        "model_path": "./models/yolo/best.pt",
        "target_class": "seat",
        "confidence": 0.25,
        "iou": 0.45,
        "device": "cuda",
        "imgsz": 960
      },
      "patchcore": {
        "backend": "full",
        "image_size": 256,
        "patch_size": 32,
        "stride": 16,
        "backbone_name": "wide_resnet50_2",
        "feature_layers": ["layer2", "layer3"],
        "backbone_pretrained": true,
        "backbone_device": "cuda",
        "texture_input": "lab_l"
      },
      "color_branch": {
        "enabled": false
      },
      "filter_classifier": {
        "enabled": true,
        "model_path": "./deployed_models/filter_classifier/",
        "device": "cuda",
        "confidence_threshold": 0.5
      },
      "rule_engine": {
        "enabled": true,
        "deployed_rules_path": "./deployed_rules/rules.json"
      }
    }
  ],
  "plc": {
    "enabled": false,
    "host": "192.168.1.100",
    "port": 502,
    "defect_coil": 100,
    "stop_coil": 101
  },
  "line_signal": {
    "enabled": false,
    "type": "virtual",
    "host": "127.0.0.1",
    "port": 9100,
    "timeout_s": 0.1,
    "reconnect_interval_s": 2.0,
    "pulse_width_s": 0.05,
    "clear_request_on_ack": false,
    "also_send_legacy_plc_defect": false,
    "capture_request_coil": 10,
    "capture_ack_coil": 11,
    "busy_coil": 12,
    "done_coil": 13,
    "ok_coil": 14,
    "ng_coil": 15,
    "reject_coil": 16,
    "fault_coil": 17,
    "line_status_register": 0,
    "part_id_register": 20,
    "seat_model_register": 40,
    "defect_code_register": 60,
    "fault_code_register": 61
  },
  "offline_platform": {
    "upload_base_url": "",
    "hot_reload_enabled": false,
    "hot_reload_poll_seconds": 30
  },
  "alert": {
    "ng_popup_timeout_seconds": 30,
    "ng_default_action": "confirm_defect",
    "sound_enabled": false
  },
  "storage": {
    "log_dir": "./logs",
    "log_retention_days": 30,
    "screenshot_dir": "./screenshots"
  }
}
