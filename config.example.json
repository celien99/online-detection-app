{
  "app": {
    "line_id": "A-03",
    "station_id": "seat_inspection",
    "language": "zh-CN",
    "fullscreen": true,
    "grid_layout": "2x2",
    "inspection_mode": "continuous",
    "trigger_poll_interval_s": 0.05,
    "capture_timeout_s": 2.0
  },
  "cameras": [
    {
      "camera_id": "CAM_FRONT",
      "source": "mvs://0?exposure_time=6000&gain=8&pixel_format=bgr8",
      "type": "mvs",
      "enabled": true,
      "efficientad_model_path": "./models/cam_front.pt",
      "filter_classifier": {
        "enabled": true,
        "model_path": "./deployed_models/filter_classifier/",
        "device": "cuda",
        "confidence_threshold": 0.5
      },
      "proposal": {
        "heatmap_threshold_mode": "adaptive",
        "max_proposals": 20
      },
      "rule_engine": {
        "enabled": true,
        "deployed_rules_path": "./deployed_rules/rules.json"
      },
      "calibration": {
        "normalizer_path": "./calibration/CAM_FRONT_normalizer.json",
        "projector_path": "./calibration/projector.pt"
      }
    }
  ],
  "plc": {
    "enabled": false,
    "host": "192.168.1.100",
    "port": 502,
    "defect_coil": 100,
    "stop_coil": 101
  },
  "line_signal": {
    "enabled": false,
    "type": "virtual",
    "host": "127.0.0.1",
    "port": 9100,
    "timeout_s": 0.1,
    "reconnect_interval_s": 2.0,
    "capture_request_coil": 10,
    "capture_ack_coil": 11,
    "busy_coil": 12,
    "done_coil": 13,
    "ok_coil": 14,
    "ng_coil": 15,
    "reject_coil": 16,
    "fault_coil": 17,
    "line_status_register": 0,
    "part_id_register": 20,
    "seat_model_register": 40,
    "defect_code_register": 60,
    "fault_code_register": 61
  },
  "offline_platform": {
    "upload_base_url": "",
    "hot_reload_enabled": false,
    "hot_reload_poll_seconds": 30
  },
  "alert": {
    "ng_popup_timeout_seconds": 30,
    "ng_default_action": "confirm_defect",
    "sound_enabled": false
  },
  "storage": {
    "log_dir": "./logs",
    "log_retention_days": 30,
    "screenshot_dir": "./screenshots"
  }
}
